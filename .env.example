# Copy this file to .env (next to docker-compose.yml) and fill it in. Never commit .env: it holds the secret.

# Random string of at least 16 characters, generated once and kept: it encrypts the secrets stored in the database
# (SSO, e-mail, backups, plugin accounts) and signs sessions. Changing it later means typing those secrets again.
#   Linux, macOS:  openssl rand -hex 32
#   Windows:       -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })     (in PowerShell)
APP_SECRET=

# Address where you open Nootion in the browser (without a trailing /).
APP_URL=http://localhost:3000

TZ=Europe/Paris
